{
  "name": "securevault",
  "private": true,
  "version": "1.0.0",
  "description": "SecureVault — encrypted document vault (web app)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run dev -w @securevault/api\" \"npm run dev:open -w @securevault/web\"",
    "start": "npm run dev",
    "build": "npm run build -w @securevault/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:search-load": "node scripts/search-load-test.mjs",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "audit:deps:all": "npm audit --audit-level=high",
    "format": "prettier --write .",
    "db:generate": "npm run generate -w @securevault/db",
    "db:migrate": "npm run migrate:dev -w @securevault/db",
    "db:deploy": "npm run migrate:deploy -w @securevault/db",
    "db:studio": "npm run studio -w @securevault/db",
    "postinstall": "npm run db:generate"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
