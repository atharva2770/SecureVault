*.sln
*.sw?

# AI assistant / local tooling (not part of the product)
.agents/
.claude/
.windsurf/
skills-lock.json

# Electron / auto-update local cache
securevault-updater/

# Prisma generated output (client lives under node_modules; keep migrations tracked)
/src/generated/prisma

# Local encrypted vault blobs during development (if stored in-repo for testing)
/vault-data/
/encrypted-blobs/

