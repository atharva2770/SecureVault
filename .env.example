# Copy to `.env` at the repo root. Never commit `.env`.
# The API refuses to start if a required variable is missing or still a placeholder.

# --- required ---

# SQL Server (SQL auth). Used when USE_TRUSTED_CONNECTION is not true.
DATABASE_URL="sqlserver://localhost:1433;database=SecureVault;user=sa;password=YOUR_PASSWORD;encrypt=true;trustServerCertificate=true"

# SQL Server (Windows Auth). Used when USE_TRUSTED_CONNECTION=true.
# DATABASE_URL_TRUSTED="sqlserver://localhost:1433;database=SecureVault;trustedConnection=true;trustServerCertificate=true"
# USE_TRUSTED_CONNECTION=true

# Signed session cookie secret — at least 32 random characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_COOKIE_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# AES-256 wrap key for file DEKs — 32 bytes as 64 hex chars.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_KMS_WRAP_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- optional (defaults shown) ---

# NODE_ENV=development
# API_PORT=4000
# API_HOST=127.0.0.1
# API_COOKIE_NAME=sv_session
# API_CSRF_COOKIE_NAME=sv_csrf
# WEB_ORIGIN=http://localhost:5173
# VAULT_IDLE_TIMEOUT_MS=900000
# VAULT_SESSION_MAX_MS=43200000
# API_JSON_BODY_LIMIT=65536
# API_MAX_UPLOAD_BYTES=104857600
# Encrypted files (Windows default: F:\Docman files). Mirrors vault folders.
# Explorer can open folders only; ciphertext files are hidden system files.
# VAULT_BLOB_ROOT=F:\Docman files
# PASSWORD_BREACH_CHECK=false
# Default HTTP rate-limit bucket (req / minute / IP). Raise for search load tests.
# API_RATE_LIMIT_DEFAULT=600

# Production (NODE_ENV=production) also requires:
# API_COOKIE_SECURE=true
# HTTPS_ENABLED=true
# API_TRUST_PROXY=true
# Comma-separated IPs/CIDRs (or loopback|linklocal|uniquelocal) whose
# X-Forwarded-For is believed. Only consulted when API_TRUST_PROXY=true.
# Set this to the reverse proxy's address; never widen it to 0.0.0.0/0.
# API_TRUSTED_PROXIES=127.0.0.1,::1
# WEB_ORIGIN=https://your-real-origin.example
