# SQL Server — SQL authentication (default)
DATABASE_URL="sqlserver://localhost:1433;database=SecureVault;user=sa;password=YOUR_PASSWORD;encrypt=true;trustServerCertificate=true"

# SQL Server — Windows Authentication (set USE_TRUSTED_CONNECTION=true)
# DATABASE_URL_TRUSTED="sqlserver://localhost:1433;database=SecureVault;integratedSecurity=true;encrypt=true;trustServerCertificate=true"
# USE_TRUSTED_CONNECTION=true

# Vault session idle auto-lock (milliseconds). Default: 900000 (15 minutes)
# VAULT_IDLE_TIMEOUT_MS=900000

# Web API (local only; does not deploy the database)
# API_PORT=4000
# API_HOST=127.0.0.1
# API_COOKIE_SECRET=change-me-to-a-long-random-string
# WEB_ORIGIN=http://localhost:5173
# Optional: Electron loads the web UI instead of the native desktop renderer
# DESKTOP_USE_WEB_UI=true

# Phase 3 — local encrypted blobs + wrapping key (not a cloud KMS yet)
# Generate wrap key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# VAULT_KMS_WRAP_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# VAULT_BLOB_ROOT=data/vault-blobs
# API_MAX_UPLOAD_BYTES=104857600
